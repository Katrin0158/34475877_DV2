{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 70,
  "data": {
    "url": "https://raw.githubusercontent.com/Katrin0158/Test_DV2/66596817cc3a120bfa44d2c46e448f8faccf2b3b/s2/data/movies.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "decade": "number",
        "month": "number",
        "rating": "number",
        "runtime": "number",
        "budget": "number",
        "revenue": "number",
        "roi": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year<1970?'Before 1970':datum.year<1990?'1970–89':datum.year<2000?'1990s':datum.year<2010?'2000s':'2010s'",
      "as": "era"
    },
    {
      "density": "rating",
      "groupby": [
        "era"
      ],
      "extent": [
        2,
        9.5
      ],
      "steps": 60
    }
  ],
  "mark": {
    "type": "area",
    "color": "#e8a838",
    "opacity": 0.85,
    "line": {
      "color": "#fff3c4"
    }
  },
  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Average audience rating (out of 10)"
    },
    "y": {
      "field": "density",
      "type": "quantitative",
      "axis": null
    },
    "row": {
      "field": "era",
      "type": "ordinal",
      "sort": [
        "Before 1970",
        "1970–89",
        "1990s",
        "2000s",
        "2010s"
      ],
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelFontSize": 12
      }
    }
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8",
      "gridColor": "#2f2a25",
      "domainColor": "#5a5248",
      "tickColor": "#5a5248",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "header": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "title": {
      "color": "#f3ead9"
    }
  }
}