{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Countries that make films together",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Katrin0158/Test_DV2/66596817cc3a120bfa44d2c46e448f8faccf2b3b/s2/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#6baed6"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Katrin0158/Test_DV2/1872b639fc8474365ed03833de942b33552b06c1/s2/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#2f3a44",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Katrin0158/Test_DV2/1872b639fc8474365ed03833de942b33552b06c1/s2/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6e2dd",
        "stroke": "#b0a89d",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Katrin0158/Test_DV2/e8dbbdf1ede89ae97e65c00f6dcad3fcc149af72/s2/data/links.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round"
      },
      "encoding": {
        "stroke": {
          "value": "#e8a838"
        },
        "opacity": {
          "value": 0.6
        },
        "strokeWidth": {
          "field": "properties.count",
          "type": "quantitative",
          "title": "Joint films",
          "scale": {
            "type": "sqrt",
            "range": [
              0.6,
              9
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.pair",
            "title": "Countries"
          },
          {
            "field": "properties.count",
            "title": "Joint films"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8",
      "gridColor": "#2f2a25",
      "domainColor": "#5a5248",
      "tickColor": "#5a5248",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "header": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "title": {
      "color": "#f3ead9"
    }
  }
}