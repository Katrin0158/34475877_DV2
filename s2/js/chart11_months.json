{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/movies.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "decade": "number",
        "month": "number",
        "rating": "number",
        "runtime": "number",
        "budget": "number",
        "revenue": "number",
        "roi": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.revenue!=null && datum.year>=1990"
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#e8a838"
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "title": "Release month",
      "axis": {
        "labelExpr": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.value-1]",
        "labelAngle": 0
      }
    },
    "y": {
      "aggregate": "median",
      "field": "revenue",
      "type": "quantitative",
      "title": "Median box office (US$)",
      "axis": {
        "format": "~s"
      }
    },
    "tooltip": [
      {
        "field": "month",
        "title": "Month"
      },
      {
        "aggregate": "median",
        "field": "revenue",
        "format": ",.0f",
        "title": "Median US$"
      },
      {
        "aggregate": "count",
        "title": "Films"
      }
    ]
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8",
      "gridColor": "#2f2a25",
      "domainColor": "#5a5248",
      "tickColor": "#5a5248",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "header": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "title": {
      "color": "#f3ead9"
    }
  }
}