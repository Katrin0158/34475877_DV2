{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Films per million people, by production country",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#17222b"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#2f3a44",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#3a342d",
        "stroke": "#14110f",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/countries.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "Films": "number",
                  "Revenue": "number",
                  "Rating": "number",
                  "Population": "number",
                  "FilmsPerMillion": "number",
                  "longitude": "number",
                  "latitude": "number"
                }
              }
            },
            "key": "Country",
            "fields": [
              "Films",
              "Population"
            ]
          }
        },
        {
          "filter": "datum.Films>0 && datum.Population>0"
        },
        {
          "calculate": "datum.Films/datum.Population*1000000",
          "as": "Films per million people"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#14110f",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "Films per million people",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              0.05,
              0.25,
              1,
              3,
              8
            ],
            "range": [
              "#4a3a2a",
              "#7a5a2a",
              "#b07a26",
              "#e8a838",
              "#f6d27a",
              "#fff3c4"
            ]
          },
          "legend": {
            "format": ".2f"
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Films",
            "type": "quantitative"
          },
          {
            "field": "Films per million people",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8",
      "gridColor": "#2f2a25",
      "domainColor": "#5a5248",
      "tickColor": "#5a5248",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "header": {
      "labelColor": "#cfc6b8",
      "titleColor": "#cfc6b8"
    },
    "title": {
      "color": "#f3ead9"
    }
  }
}