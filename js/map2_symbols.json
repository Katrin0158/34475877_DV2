{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Total box office of films made in each country, up to the chosen year",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#9fbfd0"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#b3cddb",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6d0c2",
        "stroke": "#f3ecdd",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/film_country.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "revenue": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year<=Year_selection"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "revenue",
              "as": "Box office"
            },
            {
              "op": "count",
              "as": "Films"
            }
          ],
          "groupby": [
            "Country",
            "longitude",
            "latitude"
          ]
        },
        {
          "filter": "datum['Box office']>0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "color": "#c8710a",
        "stroke": "#fffaf0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Box office",
          "type": "quantitative",
          "title": "Box office (US$)",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              400000000000
            ],
            "range": [
              0,
              3500
            ]
          },
          "legend": {
            "labelExpr": "replace(format(datum.value,'~s'),'G','B')"
          }
        },
        "tooltip": [
          {
            "field": "Country"
          },
          {
            "field": "Box office",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Films",
            "type": "quantitative"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218",
      "gridColor": "#e3d9c4",
      "domainColor": "#9a8f7b",
      "tickColor": "#9a8f7b",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "header": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "title": {
      "color": "#2b2218",
      "font": "Times New Roman",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "offset": 12
    }
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2016,
      "bind": {
        "input": "range",
        "min": 1950,
        "max": 2016,
        "step": 1,
        "name": "Films released up to: "
      }
    }
  ]
}