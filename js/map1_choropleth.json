{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Films per million people, by production country",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#9fbfd0"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#b3cddb",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6d0c2",
        "stroke": "#f3ecdd",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/countries.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "Films": "number",
                  "Revenue": "number",
                  "Rating": "number",
                  "Population": "number",
                  "FilmsPerMillion": "number",
                  "longitude": "number",
                  "latitude": "number"
                }
              }
            },
            "key": "Country",
            "fields": [
              "Films",
              "Population"
            ]
          }
        },
        {
          "filter": "datum.Films>0 && datum.Population>0"
        },
        {
          "calculate": "datum.Films/datum.Population*1000000",
          "as": "Films per million people"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f3ecdd",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "Films per million people",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              0.05,
              0.25,
              1,
              3,
              8
            ],
            "range": [
              "#f3d28c",
              "#e8aa44",
              "#cc7a1a",
              "#a1520a",
              "#6e3306",
              "#3f1d03"
            ]
          },
          "legend": {
            "format": ".2f"
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Films",
            "type": "quantitative"
          },
          {
            "field": "Films per million people",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218",
      "gridColor": "#e3d9c4",
      "domainColor": "#9a8f7b",
      "tickColor": "#9a8f7b",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "header": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "title": {
      "color": "#2b2218",
      "font": "Times New Roman",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "offset": 12
    }
  }
}