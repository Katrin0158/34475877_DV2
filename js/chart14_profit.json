{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Biggest money-makers and money-losers",
  "width": "container",
  "height": {
    "step": 22
  },
  "data": {
    "url": "https://katrin0158.github.io/34475877_DV2/data/profit.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "profit": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "title",
      "type": "nominal",
      "sort": {
        "field": "profit",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 190
      }
    }
  },
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "profit",
          "type": "quantitative",
          "title": "Profit (US$)",
          "axis": {
            "labelExpr": "(datum.value<0?'−':'')+'$'+replace(format(abs(datum.value),'~s'),'G','B')"
          }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Made money",
              "Lost money"
            ],
            "range": [
              "#b45f06",
              "#2f4858"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "title",
            "title": "Film"
          },
          {
            "field": "profit",
            "title": "Profit (US$)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#2b2218"
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "(datum.profit<0?'−':'')+'$'+format(abs(datum.profit)/1e6,',.0f')+'M'",
          "as": "lab"
        },
        {
          "calculate": "max(datum.profit,0)",
          "as": "xp"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#2b2218",
        "baseline": "middle",
        "align": "left",
        "dx": 5
      },
      "encoding": {
        "x": {
          "field": "xp",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218",
      "gridColor": "#e3d9c4",
      "domainColor": "#9a8f7b",
      "tickColor": "#9a8f7b",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "header": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "title": {
      "color": "#2b2218",
      "font": "Times New Roman",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "offset": 12
    }
  }
}