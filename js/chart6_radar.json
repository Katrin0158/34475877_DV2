    {
      "data": {
        "url": "https://katrin0158.github.io/34475877_DV2/data/radar.csv",
        "format": {
          "type": "csv",
          "parse": {
            "idx": "number",
            "score": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.score*sin(2*PI*datum.idx/5)",
          "as": "x"
        },
        {
          "calculate": "datum.score*cos(2*PI*datum.idx/5)",
          "as": "y"
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              -150,
              150
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              -150,
              150
            ]
          },
          "axis": null
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "title": "Genre",
          "scale": {
            "domain": [
              "Documentary",
              "Horror",
              "Animation",
              "Drama",
              "Action"
            ],
            "range": [
              "#882255",
              "#3b2f6b",
              "#999933",
              "#0072B2",
              "#D55E00"
            ]
          },
          "legend": {
            "title": "Genre",
            "orient": "bottom",
            "columns": 5
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "interpolate": "linear-closed",
            "strokeWidth": 2.5,
            "filled": true,
            "fillOpacity": 0.12
          },
          "encoding": {
            "order": {
              "field": "idx",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 55,
            "opacity": 1
          },
          "encoding": {
            "tooltip": [
              {
                "field": "genre",
                "title": "Genre"
              },
              {
                "field": "measure",
                "title": "Measure"
              },
              {
                "field": "actual",
                "title": "Actual value"
              },
              {
                "field": "score",
                "title": "Score (0-100)"
              }
            ]
          }
        }
      ]
    }
