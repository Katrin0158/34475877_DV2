{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Countries that make films together",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#9fbfd0"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#b3cddb",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6d0c2",
        "stroke": "#f3ecdd",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/links.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round"
      },
      "encoding": {
        "stroke": {
          "value": "#c8710a"
        },
        "opacity": {
          "value": 0.6
        },
        "strokeWidth": {
          "field": "properties.count",
          "type": "quantitative",
          "title": "Joint films",
          "scale": {
            "type": "sqrt",
            "range": [
              0.6,
              9
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.pair",
            "title": "Countries"
          },
          {
            "field": "properties.count",
            "title": "Joint films"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.properties.count>=Min_films"
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218",
      "gridColor": "#e3d9c4",
      "domainColor": "#9a8f7b",
      "tickColor": "#9a8f7b",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "header": {
      "labelColor": "#4a4033",
      "titleColor": "#2b2218"
    },
    "title": {
      "color": "#2b2218",
      "font": "Times New Roman",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "offset": 12
    }
  },
  "params": [
    {
      "name": "Min_films",
      "value": 30,
      "bind": {
        "input": "range",
        "min": 6,
        "max": 150,
        "step": 2,
        "name": "Show partnerships with at least this many joint films: "
      }
    }
  ]
}